# Copy this file to ".env" and fill in your own key.
# The real ".env" is git-ignored, so your key never ends up on GitHub.
#
# Alternative: instead of a ".env" file, you can set GEMINI_API_KEY as a
# normal system/user environment variable. A real environment variable
# always wins over the value in this file, and it works from any folder.

# Google Gemini API key (required for the AI task breakdown).
# Get one for free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: pick a different Gemini model (defaults to gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash
