# This file is ONLY needed if you want to connect a school portal
# (Logineo NRW / IServ). Without it, the portal buttons stay disabled.
#
# Real config lives OUTSIDE the repo, at:
#   ~/.focustycoon/portal.env      (e.g. C:\Users\<you>\.focustycoon\portal.env)
# Create that folder/file yourself and fill it in - the app never reads a
# "portal.env" placed next to this example, and nothing under
# ~/.focustycoon/ is ever part of the git repo, so your key and encrypted
# password stay on your machine.

# A long random string used to encrypt your saved portal password (AES-256-GCM).
# Make one up (at least 16 characters). If you lose it, you must reconnect the portal.
PORTAL_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Optional: pre-fill the school URLs in the connect form.
# PORTAL_LOGINEO_URL=https://your-logineo-school-url
# PORTAL_ISERV_URL=https://iserv.your-school.de
